# =============================================================================
# TREWE — ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# Required. Connection details for the local Postgres instance.
# Format: plain strings — no quotes needed in .env files.
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trewe_dev
POSTGRES_USER=trewe
# Required. Choose a strong password for local dev.
POSTGRES_PASSWORD=changeme

# Full DSN assembled from the fields above — used by the app and migration runner.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://trewe:changeme@localhost:5432/trewe_dev

# Test database — used by docker-compose.test.yml and the CI pipeline.
TEST_DATABASE_URL=postgresql://trewe:changeme@localhost:5432/trewe_test

# -----------------------------------------------------------------------------
# Redis
# Required. Connection details for the local Redis instance.
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Optional. Leave blank if Redis has no password (default for local dev).
REDIS_PASSWORD=

REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# pgAdmin (dev-only UI — never used in production)
# Required for the pgAdmin container to start.
# Format: valid email address / any string password.
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@trewe.local
PGADMIN_DEFAULT_PASSWORD=pgadmin_changeme

# -----------------------------------------------------------------------------
# API Server
# -----------------------------------------------------------------------------
# Port the Express API listens on.
# Optional — defaults to 4000.
API_PORT=4000

# Secret used to sign session tokens / JWTs.
# Required in production. Any random string works locally.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string

# Environment name — controls log verbosity and error detail.
# Values: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# Shopify Connector
# Optional — only required when testing Shopify integrations locally.
# Obtain from your Shopify Partner / App dashboard.
# -----------------------------------------------------------------------------
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# The URL Shopify will redirect to after OAuth. Must be an HTTPS URL in prod.
SHOPIFY_REDIRECT_URI=http://localhost:4000/oauth/shopify/callback
# Comma-separated list of OAuth scopes your app requests.
SHOPIFY_SCOPES=read_orders,read_products,write_fulfillments

# -----------------------------------------------------------------------------
# Next.js Dashboard
# All NEXT_PUBLIC_ variables are exposed to the browser bundle — never put
# secrets here.
# -----------------------------------------------------------------------------
# URL of the API server, as seen from the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Port the Next.js dev server listens on.
NEXT_PUBLIC_PORT=3000
