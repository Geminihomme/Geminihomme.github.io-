{
  "name": "@trewe/db",
  "version": "0.1.0",
  "private": true,
  "description": "Database client, migrations, and seeds for Trewe",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": "./dist/client.js",
    "./migrate": "./dist/migrate.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "migrate": "node --loader ts-node/esm src/migrate.ts",
    "seed": "node --loader ts-node/esm src/seeds/index.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "ts-node": "^10.9.2"
  }
}
