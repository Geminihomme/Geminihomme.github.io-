{
  "name": "@trewe/api",
  "version": "0.1.0",
  "private": true,
  "description": "Express API server for Trewe",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "node --loader ts-node/esm --watch src/server.ts",
    "test": "node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@trewe/connectors": "*",
    "@trewe/db": "*",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2"
  }
}
